---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Page not found" description="This page doesn't exist.">
    <div class="max-w-5xl mx-auto px-6 py-32 text-center">
        <p class="text-teal-400 text-sm font-medium uppercase tracking-widest mb-4">404</p>
        <h1 class="text-3xl sm:text-4xl font-bold text-zinc-100 mb-4">Page not found</h1>
        <p class="text-zinc-400 leading-relaxed mb-10">
            The page you're looking for doesn't exist or has moved.
        </p>
        <a
            href="/"
            class="inline-flex items-center gap-2 px-6 py-3 bg-teal-700 hover:bg-teal-600 text-white rounded-xl font-medium transition-all duration-200 hover:shadow-lg hover:shadow-teal-500/20"
        >
            Back to home
        </a>
    </div>
</Layout>
