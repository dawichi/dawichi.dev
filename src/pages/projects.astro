---
import Layout from '../layouts/Layout.astro'
import { projects } from '../config/projects'
import ProjectCard from '../components/ProjectCard.astro'
import Icon from '../components/Icon.astro'
---

<Layout
    title="Projects"
    description="Open source projects by dawichi: TypeScript, NestJS, Svelte, React, Astro and more."
>
    <div class="max-w-5xl mx-auto px-6 py-32">
        <a
            href="/"
            class="inline-flex items-center gap-2 text-zinc-400 hover:text-zinc-300 transition-colors text-sm mb-12"
        >
            <Icon name="chevron-left" size={14} />
            Back
        </a>

        <p class="text-teal-400 text-sm font-medium uppercase tracking-widest mb-4">Projects</p>
        <h1 class="text-3xl sm:text-4xl font-bold text-zinc-100 mb-4">All projects</h1>
        <p class="text-zinc-400 leading-relaxed mb-12 max-w-2xl">
            A collection of open source projects I've built in my spare time. From games to tools to
            this very site.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {projects.map((project) => <ProjectCard project={project} showImage headingLevel="h2" />)}
        </div>
    </div>
</Layout>
