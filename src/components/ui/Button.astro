---
import type { HTMLAttributes } from 'astro/types'

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
    href: string
    variant?: 'primary' | 'secondary'
    size?: 'md' | 'lg'
    external?: boolean
    class?: string
}

const {
    href,
    variant = 'primary',
    size = 'md',
    external = false,
    class: className,
    ...rest
} = Astro.props
---

<a
    href={href}
    class:list={[
        'inline-flex items-center gap-2 font-medium rounded-xl transition-all duration-200',
        size === 'md' ? 'px-6 py-3' : 'px-8 py-4 text-lg gap-3',
        variant === 'primary'
            ? 'bg-teal-700 hover:bg-teal-600 text-white hover:shadow-lg hover:shadow-teal-500/20'
            : 'border border-zinc-800 hover:border-zinc-600 text-zinc-300 hover:text-zinc-100',
        className,
    ]}
    {...external && { target: '_blank', rel: 'noopener noreferrer' }}
    {...rest}
>
    <slot />
    {external && <span class="sr-only">(opens in a new tab)</span>}
</a>
