---
import type { ProjectStatus } from '../../lib/projects'

interface Props {
    status: ProjectStatus
}

const { status } = Astro.props

const badges: Partial<Record<ProjectStatus, { label: string; class: string }>> = {
    beta: { label: 'Private beta', class: 'bg-teal-900/40 text-teal-300 border-teal-800/60' },
    'in-development': {
        label: 'In development',
        class: 'bg-amber-900/30 text-amber-300 border-amber-800/50',
    },
    archived: { label: 'Archived', class: 'bg-zinc-800 text-zinc-400 border-zinc-700' },
}

const badge = badges[status]
---

{
    badge && (
        <span
            class:list={[
                'inline-flex items-center text-xs font-medium px-2 py-0.5 rounded-md border whitespace-nowrap',
                badge.class,
            ]}
        >
            {badge.label}
        </span>
    )
}
