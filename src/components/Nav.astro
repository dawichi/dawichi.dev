---
import { links } from '../config/site'

interface NavItem {
    label: string
    href: string
    external?: boolean
}

const items: NavItem[] = [
    { label: 'About', href: '/#about' },
    { label: 'Experience', href: '/#experience' },
    { label: 'Skills', href: '/#skills' },
    { label: 'Projects', href: '/#projects' },
    { label: 'Blog', href: links.blog, external: true },
]
const contact: NavItem = { label: 'Contact', href: '/#contact' }
---

<header
    class="fixed top-0 left-0 right-0 z-50 bg-[#09090b]/80 backdrop-blur-xl border-b border-zinc-900"
>
    <div class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
        <a
            href="/"
            class="font-mono font-semibold text-zinc-100 tracking-tight hover:text-teal-400 transition-colors duration-200"
        >
            dawichi
        </a>

        <nav aria-label="Main" class="hidden md:block">
            <ul class="flex items-center gap-8">
                {
                    items.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                class="text-sm text-zinc-400 hover:text-zinc-100 transition-colors duration-200"
                                target={item.external ? '_blank' : undefined}
                                rel={item.external ? 'noopener noreferrer' : undefined}
                            >
                                {item.label}
                                {item.external && <span class="sr-only">(opens in a new tab)</span>}
                            </a>
                        </li>
                    ))
                }
                <li>
                    <a
                        href={contact.href}
                        class="text-sm px-4 py-1.5 bg-teal-700 hover:bg-teal-600 text-white rounded-lg font-medium transition-colors duration-200"
                    >
                        {contact.label}
                    </a>
                </li>
            </ul>
        </nav>

        <button
            id="menu-btn"
            type="button"
            class="md:hidden flex flex-col gap-1.5 p-2 text-zinc-400 hover:text-zinc-100 transition-colors"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <span class="menu-bar block w-5 h-px bg-current transition-all duration-200"></span>
            <span class="menu-bar block w-5 h-px bg-current transition-all duration-200"></span>
            <span class="menu-bar block w-5 h-px bg-current transition-all duration-200"></span>
        </button>
    </div>

    <nav
        id="mobile-menu"
        aria-label="Main"
        class="hidden md:hidden border-t border-zinc-900 bg-[#09090b]"
    >
        <ul class="max-w-5xl mx-auto px-6 py-4 flex flex-col gap-1">
            {
                [...items, contact].map((item) => (
                    <li>
                        <a
                            href={item.href}
                            class="mobile-link block text-sm text-zinc-400 hover:text-zinc-100 py-2.5 transition-colors duration-200"
                            target={item.external ? '_blank' : undefined}
                            rel={item.external ? 'noopener noreferrer' : undefined}
                        >
                            {item.label}
                            {item.external && <span class="sr-only">(opens in a new tab)</span>}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>

<script>
    const btn = document.getElementById('menu-btn')
    const menu = document.getElementById('mobile-menu')
    const [bar1, bar2, bar3] = document.querySelectorAll('.menu-bar')

    function setOpen(open: boolean) {
        menu?.classList.toggle('hidden', !open)
        btn?.setAttribute('aria-expanded', String(open))
        bar1?.classList.toggle('translate-y-[7px]', open)
        bar1?.classList.toggle('rotate-45', open)
        bar2?.classList.toggle('opacity-0', open)
        bar3?.classList.toggle('-translate-y-[7px]', open)
        bar3?.classList.toggle('-rotate-45', open)
    }

    const isOpen = () => btn?.getAttribute('aria-expanded') === 'true'

    btn?.addEventListener('click', () => setOpen(!isOpen()))

    document.querySelectorAll('.mobile-link').forEach((link) => {
        link.addEventListener('click', () => setOpen(false))
    })

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && isOpen()) {
            setOpen(false)
            btn?.focus()
        }
    })

    document.addEventListener('click', (event) => {
        const target = event.target as Node
        if (isOpen() && !menu?.contains(target) && !btn?.contains(target)) setOpen(false)
    })
</script>
