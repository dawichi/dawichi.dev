---
import Icon from './Icon.astro'
import Section from './ui/Section.astro'
import { skills } from '../config/skills'
---

<Section id="skills" label="Skills" title="What I build and how I work">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
            skills.map((cat) => (
                <div class="card hover:border-zinc-700 p-6 flex flex-col gap-3 transition-colors duration-200">
                    <div class="flex items-center gap-3">
                        <Icon name={cat.icon} class="text-teal-400 shrink-0" />
                        <h3 class="text-zinc-100 font-semibold">{cat.label}</h3>
                    </div>
                    <p class="text-zinc-400 text-sm leading-relaxed grow">{cat.description}</p>
                    <div class="flex flex-wrap gap-2">
                        {cat.tags.map((tag) => (
                            <span class="text-xs px-2.5 py-1 rounded-md font-medium bg-zinc-800 text-zinc-400">
                                {tag}
                            </span>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>
</Section>
