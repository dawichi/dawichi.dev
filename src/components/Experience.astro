---
import Icon from './Icon.astro'
import Section from './ui/Section.astro'
import {
    education,
    formatDuration,
    formatPeriod,
    monthKey,
    work,
    type WorkMode,
} from '../config/experience'

const modeStyles: Record<WorkMode, string> = {
    remote: 'bg-teal-900/40 text-teal-400 border border-teal-800/50',
    hybrid: 'bg-zinc-800 text-zinc-400 border border-zinc-700',
    'on-site': 'bg-zinc-800 text-zinc-400 border border-zinc-700',
}
---

<Section id="experience" label="Experience" title="Where I've worked & studied">
    <div class="grid md:grid-cols-2 gap-12">
        <!-- Work -->
        <div>
            <h3 class="heading-2 mb-6">Work</h3>
            <div class="relative pl-6 border-l border-zinc-800 space-y-8">
                {
                    work.map((item, i) => (
                        <div class="relative">
                            <span
                                class={`absolute -left-[30px] top-1.5 w-2.5 h-2.5 rounded-full ring-4 ring-[#09090b] ${i === 0 ? 'bg-teal-500' : 'bg-zinc-600'}`}
                            />
                            <p class="meta mb-1">{formatPeriod(item.start, item.end)}</p>
                            <h4 class="text-zinc-100 font-semibold">{item.role}</h4>
                            <div class="flex items-center gap-2 flex-wrap mt-0.5">
                                <a
                                    href={item.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-teal-400 hover:text-teal-300 hover:underline text-sm transition-colors"
                                >
                                    {item.company}
                                    <span class="sr-only">(opens in a new tab)</span>
                                </a>
                                <span
                                    class={`text-xs px-1.5 py-0.5 rounded font-medium ${modeStyles[item.mode]}`}
                                >
                                    {item.mode}
                                </span>
                            </div>
                            <div class="flex items-center gap-1 mt-1">
                                <Icon name="location" size={11} class="text-zinc-400 shrink-0" />
                                <span class="text-xs text-zinc-400 font-mono">{item.location}</span>
                                <span class="text-xs text-zinc-400 font-mono">
                                    ·{' '}
                                    <span
                                        data-live-duration={
                                            item.end ? undefined : monthKey(item.start)
                                        }
                                    >
                                        {formatDuration(item.start, item.end)}
                                    </span>
                                </span>
                            </div>
                            {item.bullets.length > 0 && (
                                <ul class="mt-2 text-zinc-400 text-sm leading-relaxed space-y-1 list-disc list-inside marker:text-zinc-600">
                                    {item.bullets.map((bullet) => (
                                        <li>{bullet}</li>
                                    ))}
                                </ul>
                            )}
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Education -->
        <div>
            <h3 class="heading-2 mb-6">Education</h3>
            <div class="relative pl-6 border-l border-zinc-800 space-y-8">
                {
                    education.map((item) => (
                        <div class="relative">
                            <span class="absolute -left-[30px] top-1.5 w-2.5 h-2.5 rounded-full bg-zinc-700 ring-4 ring-[#09090b]" />
                            <p class="meta mb-1">{item.period}</p>
                            <h4 class="text-zinc-100 font-semibold">{item.degree}</h4>
                            <p class="text-zinc-400 text-sm">{item.institution}</p>
                            {item.note && (
                                <span class="inline-block mt-1 text-xs px-2 py-0.5 bg-zinc-800 text-zinc-400 rounded-md">
                                    {item.note}
                                </span>
                            )}
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</Section>
