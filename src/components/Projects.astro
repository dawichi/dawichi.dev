---
import { projects } from '../config/projects'
import ProjectCard from './ProjectCard.astro'
import Icon from './Icon.astro'

const featured = projects.slice(0, 4)
---

<section id="projects" class="py-24 border-t border-zinc-900 scroll-mt-14">
    <div class="max-w-5xl mx-auto px-6">
        <p class="text-teal-400 text-sm font-medium uppercase tracking-widest mb-4">Projects</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-zinc-100 mb-12">What I've built</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {featured.map((project) => <ProjectCard project={project} />)}
        </div>

        <div class="mt-8 text-center">
            <a
                href="/projects"
                class="inline-flex items-center gap-2 text-zinc-400 hover:text-zinc-300 transition-colors text-sm"
            >
                See all projects
                <Icon name="chevron-right" size={14} />
            </a>
        </div>
    </div>
</section>
