---
import Icon, { type IconName } from './Icon.astro'
import Section from './ui/Section.astro'
import Button from './ui/Button.astro'
import { links, site } from '../config/site'

const channels: { label: string; href: string; icon: IconName }[] = [
    { label: 'GitHub', href: links.github, icon: 'github' },
    { label: 'LinkedIn', href: links.linkedin, icon: 'linkedin' },
    { label: 'Blog', href: links.blog, icon: 'edit' },
]
---

<Section
    id="contact"
    label="Contact"
    title="Let's work together"
    intro="Have an interesting project or role in mind? My inbox is always open."
    center
>
    <div class="flex flex-col items-center">
        <Button href={`mailto:${site.email}`} size="lg" class="mb-14">
            <Icon name="mail" size={20} />
            Send me an email
        </Button>

        <ul class="flex items-center justify-center gap-8">
            {
                channels.map((channel) => (
                    <li>
                        <a
                            href={channel.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex flex-col items-center gap-2.5 text-zinc-400 hover:text-zinc-200 transition-colors group"
                        >
                            <span class="w-12 h-12 flex items-center justify-center rounded-xl bg-zinc-900 border border-zinc-800 group-hover:border-zinc-600 transition-colors">
                                <Icon name={channel.icon} size={20} />
                            </span>
                            <span class="text-sm font-medium">{channel.label}</span>
                            <span class="sr-only">(opens in a new tab)</span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</Section>
